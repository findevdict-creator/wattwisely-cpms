{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@wattwisely/db": ["./packages/db/src/index.ts"],
      "@wattwisely/driver-core": ["./packages/driver-core/src/index.ts"],
      "@wattwisely/db/testing": ["./packages/db/src/testing/index.ts"],
      "@wattwisely/ocpp-contracts": ["./packages/ocpp-contracts/src/index.ts"],
      "@wattwisely/charger-sim": ["./packages/charger-sim/src/index.ts"],
      "@wattwisely/pricing": ["./packages/pricing/src/index.ts"],
      "@wattwisely/session-engine": ["./packages/session-engine/src/index.ts"],
      "@wattwisely/payments": ["./packages/payments/src/index.ts"],
      "@wattwisely/payments/testing": ["./packages/payments/src/testing/index.ts"],
      "@wattwisely/payments-stripe": ["./packages/payments-stripe/src/index.ts"],
      "@wattwisely/mail": ["./packages/mail/src/index.ts"],
      "@wattwisely/reports": ["./packages/reports/src/index.ts"],
      "@wattwisely/observability": ["./packages/observability/src/index.ts"],
      "@wattwisely/file-storage": ["./packages/file-storage/src/index.ts"],
      "@wattwisely/billing": ["./packages/billing/src/index.ts"],
      "@wattwisely/webhooks": ["./packages/webhooks/src/index.ts"],
      "@wattwisely/load-management": ["./packages/load-management/src/index.ts"],
      "@wattwisely/messaging": ["./packages/messaging/src/index.ts"],
      "@wattwisely/messaging/testing": ["./packages/messaging/src/testing/index.ts"],
      "@wattwisely/push": ["./packages/push/src/index.ts"],
      "@wattwisely/push/testing": ["./packages/push/src/testing/index.ts"],
      "@wattwisely/theme": ["./packages/theme/src/index.ts"],
      "@wattwisely/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
