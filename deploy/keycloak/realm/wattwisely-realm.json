{
  "realm": "wattwisely",
  "displayName": "Wattwisely",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "${KC_REALM_SSL_REQUIRED}",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 900,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR", "CODE_TO_TOKEN", "CODE_TO_TOKEN_ERROR", "UPDATE_TOTP", "REMOVE_TOTP", "UPDATE_PASSWORD", "SEND_RESET_PASSWORD"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "Wattwisely",
    "auth": "${SMTP_AUTH}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "${SMTP_STARTTLS}",
    "ssl": "false"
  },
  "browserFlow": "staff browser",
  "authenticationFlows": [
    {
      "id": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c01",
      "alias": "staff browser",
      "description": "Portal and admin console logins (module 19): password, then an authenticator app, always.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false },
        { "flowAlias": "staff browser - forms", "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "id": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c02",
      "alias": "staff browser - forms",
      "description": "Username and password, then OTP. A user without an authenticator app is asked to set one up.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "id": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c03",
      "alias": "driver browser",
      "description": "Driver app logins (module 19): password; an authenticator app only when the driver has set one up.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false },
        { "flowAlias": "driver browser - forms", "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "id": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c04",
      "alias": "driver browser - forms",
      "description": "Username and password, then the optional second factor.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "driver browser - optional 2FA", "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "id": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c05",
      "alias": "driver browser - optional 2FA",
      "description": "Asks for the OTP code only when the driver has an authenticator app configured.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "platform-staff",
        "description": "Wattwisely employees. Gives access to the admin console, never to tenant data by itself."
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "wattwisely-api",
      "name": "Wattwisely API",
      "description": "The API itself. Tokens for the API carry this client as their audience; nobody logs in with it.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "wattwisely-portal",
      "name": "Wattwisely tenant portal",
      "description": "The Angular tenant portal. Public client: authorization code flow with PKCE, no secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${PORTAL_URL}",
      "baseUrl": "/",
      "redirectUris": ["${PORTAL_URL}/*", "${PORTAL_DEV_URL}/*"],
      "webOrigins": ["${PORTAL_URL}", "${PORTAL_DEV_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PORTAL_URL}/*##${PORTAL_DEV_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "wattwisely-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wattwisely-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant memberships",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "organization",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationId": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wattwisely-admin",
      "name": "Wattwisely admin console",
      "description": "The Angular admin console for Wattwisely staff (module 9). Public client with PKCE, like the portal; the API decides who is staff.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${ADMIN_URL}",
      "baseUrl": "/",
      "redirectUris": ["${ADMIN_URL}/*", "${ADMIN_DEV_URL}/*"],
      "webOrigins": ["${ADMIN_URL}", "${ADMIN_DEV_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ADMIN_URL}/*##${ADMIN_DEV_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "wattwisely-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wattwisely-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wattwisely-driver",
      "name": "Wattwisely driver app",
      "description": "The Angular driver app (module 19). Public client with PKCE; logs in through the driver browser flow, without a mandatory authenticator app. Its tokens carry this client as their audience, so the API tells drivers from staff.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${DRIVER_URL}",
      "baseUrl": "/",
      "redirectUris": ["${DRIVER_URL}/*", "${DRIVER_DEV_URL}/*"],
      "webOrigins": ["${DRIVER_URL}", "${DRIVER_DEV_URL}"],
      "authenticationFlowBindingOverrides": {
        "browser": "7d1a4c3e-0b2f-4e8a-9c6d-5f1e2a3b4c03"
      },
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DRIVER_URL}/*##${DRIVER_DEV_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "wattwisely-driver audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wattwisely-driver",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
