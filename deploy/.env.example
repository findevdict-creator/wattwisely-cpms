# Wattwisely CPMS deployment settings.
# Do not edit .env.example on a server: run ./scripts/install.sh, which copies
# this file to .env and fills in every password. Then adjust .env if needed.

# ----- Version to run -----
# Images are pulled from GitHub's container registry. Use a released version, e.g. 0.1.0.
WATTWISELY_VERSION=main
WATTWISELY_IMAGE_PREFIX=ghcr.io/findevdict-creator/wattwisely-cpms

# ----- Public addresses -----
# https on a real server (Caddy gets certificates automatically), http for a local trial.
PUBLIC_SCHEME=https
PORTAL_HOST=portal.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
# The driver app (module 7): the QR codes printed from the portal open this address on drivers' phones.
DRIVER_HOST=charge.example.com
# Where chargers connect: wss on a real server, and a plain ws address for the few chargers without TLS.
# The portal prints these on charger setup cards; Caddy routes both hosts to the OCPP gateway.
OCPP_HOST=ocpp.example.com
OCPP_PLAIN_HOST=ocpp-plain.example.com
OCPP_URL=wss://ocpp.example.com/ocpp
OCPP_PLAIN_URL=ws://ocpp-plain.example.com/ocpp
# Refuse plain ws:// for chargers not registered with "allow plain ws". Only false for a local trial.
OCPP_REQUIRE_TLS=true
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ops@example.com
# Optional second portal address allowed to log in, e.g. http://localhost:4200 while developing.
# Leave empty on a real server.
PORTAL_DEV_URL=

# ----- Generated secrets (install.sh fills these; keep them safe) -----
POSTGRES_PASSWORD=
# The API's own database logins: the migrator owns the tables, the app role is what the API uses.
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
VALKEY_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ----- Keycloak -----
KEYCLOAK_ADMIN_USER=admin
# Who may open the Keycloak admin console (https://AUTH_HOST/admin).
# "private_ranges" means only from the server itself or a VPN / SSH tunnel.
KEYCLOAK_ADMIN_ALLOWED_IPS=private_ranges

# ----- E-mail (login codes, password resets, team invitations) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ----- Card payments: Stripe Connect (module 6) -----
# From https://dashboard.stripe.com/apikeys (use the test-mode keys, sk_test_… / pk_test_…, until go-live).
# Leave empty to run without card payments: free and RFID sessions keep working.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The signing secret of a Connect webhook endpoint pointing at https://API_HOST/v1/webhooks/stripe
# ("Listen to events on Connected accounts": account.updated, payment_intent.*, refund.*).
STRIPE_WEBHOOK_SECRET=

# ----- Operations -----
LOG_LEVEL=info
# Bench testing only: let the gateway accept any RFID tag for Authorize/StartTransaction.
# Until the drivers module, only tags the platform issued for a remote start are accepted.
OCPP_ACCEPT_UNKNOWN_ID_TAGS=false
# How many days of backups backup.sh keeps.
BACKUP_KEEP_DAYS=14
# "dev" also starts Mailpit, which catches all e-mail (http://localhost:8025), and opens
# Postgres (127.0.0.1:5432) and Mailpit's SMTP port (127.0.0.1:1025) for "npm start". Leave empty in production.
COMPOSE_PROFILES=
# The port on this machine for that Postgres. Change it (e.g. 5433) if a local Postgres already uses 5432,
# and use the same port in DATABASE_URL in apps/api/.env, apps/ocpp-gateway/.env and apps/worker/.env.
POSTGRES_DEV_PORT=5432
