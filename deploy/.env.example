# Wattwisely CPMS deployment settings.
# Do not edit .env.example on a server: run ./scripts/install.sh, which copies
# this file to .env and fills in every password. Then adjust .env if needed.

# ----- Version to run -----
# Images are pulled from GitHub's container registry. Use a released version, e.g. 0.1.0.
WATTWISELY_VERSION=main
WATTWISELY_IMAGE_PREFIX=ghcr.io/findevdict-creator/wattwisely-cpms

# ----- Public addresses -----
# https on a real server (Caddy gets certificates automatically), http for a local trial.
PUBLIC_SCHEME=https
PORTAL_HOST=portal.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
# Where chargers connect: wss on a real server, and a plain ws address for the few chargers without TLS.
# The OCPP gateway itself arrives in a later module; the portal already prints these on setup cards.
OCPP_URL=wss://ocpp.example.com/ocpp
OCPP_PLAIN_URL=ws://ocpp-plain.example.com/ocpp
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ops@example.com
# Optional second portal address allowed to log in, e.g. http://localhost:4200 while developing.
# Leave empty on a real server.
PORTAL_DEV_URL=

# ----- Generated secrets (install.sh fills these; keep them safe) -----
POSTGRES_PASSWORD=
# The API's own database logins: the migrator owns the tables, the app role is what the API uses.
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
VALKEY_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ----- Keycloak -----
KEYCLOAK_ADMIN_USER=admin
# Who may open the Keycloak admin console (https://AUTH_HOST/admin).
# "private_ranges" means only from the server itself or a VPN / SSH tunnel.
KEYCLOAK_ADMIN_ALLOWED_IPS=private_ranges

# ----- E-mail (login codes, password resets, team invitations) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ----- Operations -----
LOG_LEVEL=info
# How many days of backups backup.sh keeps.
BACKUP_KEEP_DAYS=14
# "dev" also starts Mailpit, which catches all e-mail (http://localhost:8025), and opens
# Postgres (127.0.0.1:5432) and Mailpit's SMTP port (127.0.0.1:1025) for "npm start". Leave empty in production.
COMPOSE_PROFILES=
