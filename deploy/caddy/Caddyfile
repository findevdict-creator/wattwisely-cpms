# Routes the public addresses to their services.
# With PUBLIC_SCHEME=https Caddy gets and renews Let's Encrypt certificates by itself.
# With PUBLIC_SCHEME=http (local testing) it serves plain HTTP.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$PUBLIC_SCHEME}://{$PORTAL_HOST} {
	import security_headers
	reverse_proxy portal:8080
}

{$PUBLIC_SCHEME}://{$API_HOST} {
	import security_headers
	reverse_proxy api:3000
}

# Drivers: the QR code on a plug opens charge.<domain>/c/<charger id>/<plug>.
{$PUBLIC_SCHEME}://{$DRIVER_HOST} {
	import security_headers
	reverse_proxy driver:8080
}

# Wattwisely staff: the admin console (module 9). Open to the internet like the portal; the API
# refuses anyone without a staff role. Add "not remote_ip" rules here to limit it to an office or VPN.
{$PUBLIC_SCHEME}://{$ADMIN_HOST} {
	import security_headers
	reverse_proxy admin:8080
}

# Chargers: wss://ocpp.<domain>/ocpp/<identity>. WebSocket upgrades pass through as they are.
{$PUBLIC_SCHEME}://{$OCPP_HOST} {
	reverse_proxy ocpp-gateway:3100
}

# Plain ws:// for the few chargers that cannot do TLS; the gateway only lets in chargers
# registered with "allow plain ws" (X-Forwarded-Proto tells it which door was used).
http://{$OCPP_PLAIN_HOST} {
	reverse_proxy ocpp-gateway:3100
}

{$PUBLIC_SCHEME}://{$AUTH_HOST} {
	import security_headers

	# The Keycloak admin console is only reachable from allowed networks.
	@admin_from_outside {
		path /admin*
		not remote_ip {$KEYCLOAK_ADMIN_ALLOWED_IPS}
	}
	respond @admin_from_outside "Not found" 404

	reverse_proxy keycloak:8080
}
