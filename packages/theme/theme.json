    "ink": "#0F172A",
    "text2": "#475569",
    "muted": "#94A3B8",
    "line": "#E2E8F0",
    "surface": "#F1F5F9",
    "background": "#F8FAFC",
    "white": "#FFFFFF",
    "brand": "#16A34A",
    "brandDark": "#15803D",
    "brandSoft": "#DCFCE7",
    "warning": "#D97706",
    "warningSoft": "#FEF3C7",
    "warningText": "#B45309",
    "danger": "#DC2626",
    "dangerSoft": "#FEE2E2",
    "dangerText": "#B91C1C",
    "info": "#2563EB",
    "infoSoft": "#DBEAFE",
    "infoText": "#1D4ED8"
  },
  "roles": {
    "primary": "brand",
    "onPrimary": "white",
    "primaryContainer": "brandSoft",
    "onPrimaryContainer": "brandDark",
    "inversePrimary": "brandSoft",
    "secondary": "ink",
