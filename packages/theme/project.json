{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["scope:theme", "type:lib"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --transpile-only -P packages/theme/tsconfig.lib.json packages/theme/src/main.ts"
      }
