{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ww",
  "sourceRoot": "apps/mobile/src",
  "tags": ["scope:driver", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/mobile",
        "browser": "apps/mobile/src/main.ts",
        "tsConfig": "apps/mobile/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mobile/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/inter/index.css",
          "apps/mobile/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["packages/ui/src/styles"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.5mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4500
      },
      "configurations": {
        "production": {
          "buildTarget": "mobile:build:production"
        },
        "development": {
          "buildTarget": "mobile:build:development"
        }
      }
    },
    "sync": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/mobile",
        "command": "npx cap sync"
      }
    },
    "apk": {
      "dependsOn": ["sync"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/android/app/build/outputs/apk"],
      "options": {
        "cwd": "apps/mobile/android",
        "command": "./gradlew assembleDebug"
      }
    },
    "bundle": {
      "dependsOn": ["sync"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/android/app/build/outputs/bundle"],
      "options": {
        "cwd": "apps/mobile/android",
        "command": "./gradlew bundleRelease"
      }
    }
  }
}
