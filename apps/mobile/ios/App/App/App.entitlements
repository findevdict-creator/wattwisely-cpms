<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Universal Links (module 32): a plug's QR code and an invitation link open the app on the
  driver web app's domain. APP_LINK_HOST is that domain, set in the project for a local build
  and by the release workflow (MOBILE_DRIVER_HOST) for TestFlight. The App ID needs the
  Associated Domains capability, and the domain must serve apple-app-site-association.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
