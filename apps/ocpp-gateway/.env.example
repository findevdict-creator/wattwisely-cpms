# Settings for running the OCPP gateway with "npm start" (Nx loads apps/ocpp-gateway/.env).
# Copy this file to apps/ocpp-gateway/.env. The values match the local Docker stack.
PORT=3100
LOG_LEVEL=info
# The same role as the API: row-level security applies to every query.
DATABASE_URL=postgres://wattwisely_app:CHANGE_ME@localhost:5432/wattwisely
# Chargers connect to ws://localhost:3100/ocpp/<identity> while developing, so plain ws is fine.
OCPP_REQUIRE_TLS=false
# Behind Caddy the real client address and scheme arrive in X-Forwarded-* headers.
OCPP_TRUST_PROXY=false
# Bench testing only: accepts any RFID tag. Normally only cards registered under Drivers (module 13)
# and tags the platform issued for a remote start are accepted.
OCPP_ACCEPT_UNKNOWN_ID_TAGS=true
