# Settings for running the worker with "npm start" (Nx loads apps/worker/.env).
# Copy this file to apps/worker/.env. The values match the local Docker stack.
PORT=3200
LOG_LEVEL=info
# The same role as the API and the gateway: row-level security applies to every query.
DATABASE_URL=postgres://wattwisely_app:CHANGE_ME@localhost:5432/wattwisely
# How often stopped sessions are checked for their final price.
SESSION_FINALISE_INTERVAL_MS=60000
# How often the running cost of charging sessions is updated (the design says 30 seconds).
SESSION_LIVE_COST_INTERVAL_MS=30000
# How often sessions that went silent for a day are closed as failed.
SESSION_STALE_SWEEP_INTERVAL_MS=600000
# Module 6: how often the holds of ended paid sessions are captured or released.
PAYMENT_SETTLE_INTERVAL_MS=30000
# How often paid sessions that do not get going (no card, no charger) are given up on.
SESSION_START_TIMEOUT_INTERVAL_MS=15000
# How often running RFID card starts that must be paid get their hold from the driver's saved card (module 19).
SAVED_CARD_HOLD_INTERVAL_MS=10000
# How often stored Stripe events that could not be handled are tried again.
PAYMENT_WEBHOOK_RETRY_INTERVAL_MS=60000
# Module 10: how often managed service agreements whose end date has passed are ended (hourly).
MANAGED_SERVICE_END_INTERVAL_MS=3600000
# Module 15: how often last month's invoices are drafted (once the month is over) and overdue invoices are checked.
INVOICE_INTERVAL_MS=3600000
# Module 16: how often new sessions and alerts are turned into webhook deliveries, and due deliveries are posted.
WEBHOOK_INTERVAL_MS=15000
# Module 16: let webhook endpoints point at localhost and private addresses (the API's setting of the same name).
WEBHOOK_ALLOW_PRIVATE_URLS=true
# Module 17: how often each managed site's power cap is shared out among its chargers, and how
# often chat messages are sent and linked charges reported on.
LOAD_MANAGEMENT_INTERVAL_MS=10000
MESSAGING_INTERVAL_MS=10000
# Module 17: the platform's WhatsApp Business token (the API's setting of the same name); empty = no sending.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# Stripe's secret key, the same as the API's (test mode: sk_test_…). Empty = no provider calls.
STRIPE_SECRET_KEY=
# Module 11: alerts, driver updates, receipts, exports and scheduled reports go out through this
# SMTP server; the local stack's Mailpit catches them (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@wattwisely.localhost
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Tenant logos in e-mails come from the API; alert and export e-mails link to the portal.
API_URL=http://localhost:3000
PORTAL_URL=http://localhost:4200
# Module 17: the charge and receipt links sent in chats open the driver app.
DRIVER_URL=http://localhost:4300
# How often chargers are checked for alerts, driver e-mails are queued, the outbox is sent,
# exports are built and scheduled reports are queued.
ALERT_SCAN_INTERVAL_MS=30000
SESSION_NOTIFY_INTERVAL_MS=30000
NOTIFICATION_SEND_INTERVAL_MS=15000
REPORT_EXPORT_INTERVAL_MS=15000
REPORT_SCHEDULE_INTERVAL_MS=300000
# Module 12. Object storage for export files; empty keeps them in Postgres. The same S3_* settings as the API.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# How often old rows are deleted, and after how many days (see docs/modules/12-hardening-operations.md).
RETENTION_INTERVAL_MS=3600000
RETENTION_OCPP_MESSAGES_DAYS=90
RETENTION_OUTBOX_DAYS=30
RETENTION_BELL_DAYS=90
RETENTION_DRIVER_EMAIL_DAYS=30
RETENTION_EXPORTS_DAYS=90
RETENTION_WEBHOOK_EVENTS_DAYS=90
RETENTION_WEBHOOK_DELIVERIES_DAYS=30
# How often the backlog metrics (e-mails, exports, Stripe events, open alerts) are counted.
QUEUE_STATS_INTERVAL_MS=30000
# Module 34: pushes to the mobile app. Each platform is sent to only when its key is set.
PUSH_INTERVAL_MS=15000
FCM_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_SANDBOX=true
