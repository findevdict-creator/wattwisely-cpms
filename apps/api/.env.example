# Settings for running the API with "npm start" (Nx loads apps/api/.env).
# Copy this file to apps/api/.env. The values match the local Docker stack (deploy/scripts/install.sh --local).
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200,http://portal.localhost,http://localhost:4300,http://charge.localhost,http://localhost:4400,http://admin.localhost
KEYCLOAK_ISSUER_URL=http://auth.localhost/realms/wattwisely
KEYCLOAK_JWKS_URL=http://auth.localhost/realms/wattwisely/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wattwisely-api
# The Docker stack publishes Postgres on 127.0.0.1:5432 only when COMPOSE_PROFILES includes "dev".
# The password is DB_APP_PASSWORD from deploy/.env.
DATABASE_URL=postgres://wattwisely_app:CHANGE_ME@localhost:5432/wattwisely
# The API's own public address (module 8): the logo links in e-mails and on driver pages point here.
API_URL=http://localhost:3000
PORTAL_URL=http://localhost:4200
# Where chargers connect, shown on each charger's setup card (the OCPP gateway arrives in module 4).
OCPP_URL=ws://ocpp.localhost/ocpp
OCPP_PLAIN_URL=ws://ocpp-plain.localhost/ocpp
# The driver app (module 7): the QR codes on chargers point here.
DRIVER_URL=http://localhost:4300
# Mailpit from the Docker stack catches every e-mail: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@wattwisely.localhost
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Stripe (module 6), test mode keys from https://dashboard.stripe.com/test/apikeys. Empty = card payments off.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The signing secret of the Connect webhook endpoint, or of "stripe listen --forward-to localhost:3000/v1/webhooks/stripe".
STRIPE_WEBHOOK_SECRET=
# Module 12. Object storage for export files; empty keeps them in Postgres (the local stack
# does not publish SeaweedFS's port). The same S3_* settings as the worker.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Requests per client address and minute; "npm start" reaches the API directly, so no proxy hops.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_PUBLIC_PER_MINUTE=300
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=30
TRUST_PROXY_HOPS=0
# The interactive API reference at http://localhost:3000/docs.
API_DOCS_ENABLED=true
